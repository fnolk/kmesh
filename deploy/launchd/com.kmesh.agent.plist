<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kmesh.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/kmesh</string>
		<string>--config</string>
		<string>/Users/REPLACE_WITH_USER/Library/Application Support/kmesh/config.toml</string>
		<string>--data-dir</string>
		<string>/Users/REPLACE_WITH_USER/Library/Application Support/kmesh</string>
		<string>agent</string>
		<string>run</string>
		<string>--target-id</string>
		<string>REPLACE_WITH_TARGET_UUID</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/REPLACE_WITH_USER/Library/Logs/kmesh-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/REPLACE_WITH_USER/Library/Logs/kmesh-agent.log</string>
</dict>
</plist>
